# Habblaud Configuration Example

# Terminal & PTY & Interactivity
HABBLAUD_PTY=1
HABBLAUD_WORLD=0
HABBLAUD_CODEX=0

# Remote Access & Security
HABBLAUD_REMOTE_USER=
HABBLAUD_REMOTE_PASSWORD_HASH=
HABBLAUD_REMOTE_BIND=127.0.0.1
HABBLAUD_REMOTE_PORT=4748
HABBLAUD_REMOTE_NAME=habblaud
HABBLAUD_REMOTE_ALLOW=permissions,messages,spawn,terminal
HABBLAUD_ALLOWED_HOSTS=127.0.0.1,localhost

# Pipeline (Orca / Task runner)
HABBLAUD_PIPELINE_DIR=

# Mattermost Notifications (Notifica apenas quando o sistema precisa de atenção/decisão humana)
# Ex: https://mattermost.exemplo.com/hooks/xxx-generated-token-xxx
HABBLAUD_MATTERMOST_WEBHOOK_URL=
# Canal de destino (opcional se configurado no próprio webhook)
HABBLAUD_MATTERMOST_CHANNEL=
# URL pública do Habblaud para incluir nos links de ação da notificação
HABBLAUD_PUBLIC_URL=http://127.0.0.1:4747

# Antigravity (agy) CLI binary path (opcional, padrão ~/.local/bin/agy ou PATH)
HABBLAUD_AGY_BIN=
